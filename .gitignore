# …except the React bundle, which is committed on purpose. The vanilla widget
# needs no build, so the repo can be deployed by serving it statically. Keeping
# the compiled React file in tree preserves that: host-page-react.html works
# from a plain static host with no build step at deploy time.
!react/dist/
!react/dist/product-highlights.react.js

